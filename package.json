{
  "name": "schedule-maker",
  "version": "5.9.7",
  "description": "Schedule Maker: a static schedule maker and editor. Reads a schedule grid (Raspisanie_versia_N.docx) and produces the weekly schedule, the monthly schedule and the auditorium request. Pure static web app, no build step.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "npm run validate && npm run verify && npm run compare && npm run check:subslots && npm run check:weekly && npm run check:splits && npm run check:prep && npm run check:hatch && npm run check:holidays && npm run check:zayavka",
    "validate": "node tools/validate.js",
    "verify": "node tools/verify-docx.js",
    "compare": "node tools/compare-cells.js",
    "compare-week": "node tools/compare-week.js",
    "check:subslots": "node tools/check-subslots.js",
    "check:weekly": "node tools/check-weekly.js",
    "check:splits": "node tools/check-splits.js",
    "check:prep": "node tools/check-prep.js",
    "check:hatch": "node tools/check-monthly-hatch.js",
    "check:holidays": "node tools/check-holidays.js",
    "check:zayavka": "node tools/check-zayavka.js",
    "version:bump": "node tools/bump-version.js",
    "check:dropped": "node tools/find-dropped.js",
    "check:labels": "node tools/check-time-labels.js",
    "compare:monthly": "node tools/compare-monthly.js",
    "dump:dept": "python tools/dump-dept-monthly.py",
    "browser": "node tools/browser-test.js",
    "serve:test": "node tools/serve-test.js",
    "live": "node tools/live-test.js",
    "icons": "node tools/make-icons.js",
    "shots": "node tools/shots.js"
  },
  "keywords": ["schedule", "docx", "timetable", "wordprocessingml"],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
